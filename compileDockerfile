# Use Golang image based on Debian Bookworm
FROM golang:bookworm

# Set the working directory within the container
WORKDIR /app

# Copy go.mod and go.sum files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy the rest of the application source code
COPY . .

# Commit hash injected by `just deploy_lmdb`
ARG LDFLAGS=""

# Build the Go application with the LMDB backend
RUN go build -tags=lmdb -ldflags "$LDFLAGS" -o chronicle-linux-amd64 .
